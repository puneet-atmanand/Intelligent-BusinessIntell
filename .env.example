# ==========================================
# Ask Your Data - Environment Configuration
# ==========================================

# Environment & Server
ENVIRONMENT=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Security & Cryptography
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-super-secret-jwt-signing-key-32-chars-min
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtZmVybmV0LWtleS0xMjM0NTY=

# JWT Token Expiry
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Metadata Database (Local SQLite with aiosqlite for standalone local dev)
METADATA_DATABASE_URL=sqlite+aiosqlite:///./data/intelligent_business.db
METADATA_DATABASE_SYNC_URL=sqlite:///./data/intelligent_business.db
# For Docker/PostgreSQL production deployment, use:
# METADATA_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/askyourdata
# METADATA_DATABASE_SYNC_URL=postgresql://postgres:postgres@postgres:5432/askyourdata

# Redis (Caching, Rate Limiting, Celery broker)
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# DuckDB Internal Storage (File uploads)
DUCKDB_DATABASE_PATH=/data/askyourdata.duckdb

# Super Administrator Configuration (Secure master admin bootstrap)
SUPERADMIN_EMAIL=admin@yourdomain.com
SUPERADMIN_PASSWORD=CHANGE_TO_A_STRONG_SECRET
SUPERADMIN_NAME=Super Administrator

# Backward compatibility aliases
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_TO_A_STRONG_SECRET

# AI Configuration (Disabled by default per non-negotiables)
AI_ENABLED=false
# LLM Providers: groq, gemini, openai, anthropic, ollama
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
SEND_SAMPLE_ROWS_TO_LLM=false

